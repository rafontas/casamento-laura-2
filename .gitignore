node_modules/

# Dados de produção (sugestões de música dos convidados) — não versionar,
# para não sobrescrever o que já foi salvo no servidor a cada deploy.
data/musicas.json

# Dados de produção (mensagens deixadas para os noivos) — mesmo motivo acima.
data/mensagens.json

# Senha do painel administrativo — nunca deve ir para o repositório.
admin-config.json

# Fotos da galeria — em produção fica dentro de DATA_DIR (fora da área de
# deploy); localmente, fica numa pasta "galeria-fotos" ao lado do server.js,
# pra testar com fotos reais sem precisar configurar nada.
galeria-fotos/
data/galeria-fotos/